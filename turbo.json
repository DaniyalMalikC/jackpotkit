{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/**"],
      "outputs": ["build/**", "dist/**", "lib/**", ".next/**", "!.next/cache/**"]
    },
    "build:web": {
      "dependsOn": ["^build"],
      "outputs": ["dist-web/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "doctor": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "@jackpotkit/expo-example#build:web"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "DOCS_BASE_URL",
        "DOCS_PORT",
        "E2E_BROWSERS",
        "GALLERY_BASE_URL",
        "GALLERY_PORT",
        "NATIVE_BASE_URL",
        "NATIVE_PORT",
        "NEXT_PUBLIC_NATIVE_PREVIEW_URL",
        "PLAYWRIGHT_BROWSERS_PATH",
        "PW_CHROMIUM_PATH"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
