{
  "name": "jackpotkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.3.0 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:expo": "turbo run doctor --filter=@jackpotkit/expo-example",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check:packs": "node scripts/check-package-packs.mjs",
    "changeset": "changeset",
    "clean": "turbo run clean && node scripts/clean-output.mjs .turbo coverage",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "release": "changeset publish",
    "release:status": "changeset status --verbose",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "validate": "prettier --check . && turbo run lint && turbo run typecheck && turbo run test && turbo run build && turbo run doctor --filter=@jackpotkit/expo-example && node scripts/check-boundaries.mjs && node scripts/check-package-exports.mjs && node scripts/check-package-packs.mjs",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@jackpotkit/shared-config": "workspace:*",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
