{
  "name": "@jackpotkit/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/check-links.mjs && fumadocs-mdx && next build",
    "check:links": "node scripts/check-links.mjs",
    "clean": "node ../../scripts/clean-output.mjs .next .source",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test": "node scripts/check-links.mjs && vitest run",
    "test:coverage": "node scripts/check-links.mjs && vitest run",
    "typecheck": "fumadocs-mdx && next typegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jackpotkit/core": "workspace:*",
    "@jackpotkit/react": "workspace:*",
    "@jackpotkit/theme": "workspace:*",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-typescript": "5.6.0",
    "fumadocs-ui": "16.17.9",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
