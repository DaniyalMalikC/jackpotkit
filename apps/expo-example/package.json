{
  "name": "@jackpotkit/expo-example",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "build": "expo export --platform all --output-dir dist --clear",
    "clean": "node ../../scripts/clean-output.mjs .expo dist coverage",
    "dev": "expo start",
    "doctor": "expo-doctor .",
    "ios": "expo start --ios",
    "lint": "eslint app components constants",
    "start": "expo start",
    "test": "node -e \"process.exit(0)\"",
    "test:coverage": "node -e \"process.exit(0)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@shopify/react-native-skia": "catalog:",
    "@jackpotkit/core": "workspace:*",
    "@jackpotkit/react-native": "workspace:*",
    "@jackpotkit/theme": "workspace:*",
    "expo": "catalog:",
    "expo-constants": "~57.0.14",
    "expo-haptics": "57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-status-bar": "57.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "catalog:",
    "react-native-worklets": "catalog:"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@testing-library/dom": "10.4.1",
    "@types/react": "catalog:",
    "expo-doctor": "1.20.1"
  }
}
