{
  "name": "@jackpotkit/core",
  "version": "0.3.0",
  "description": "Pure TypeScript game mechanics for JackpotKit.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Muhammad Daniyal Malik",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniyalMalikC/jackpotkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/DaniyalMalikC/jackpotkit#readme",
  "bugs": "https://github.com/DaniyalMalikC/jackpotkit/issues",
  "keywords": [
    "game-engine",
    "gamification",
    "react-native",
    "typescript"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./spin-wheel": {
      "types": "./dist/spin-wheel/index.d.ts",
      "import": "./dist/spin-wheel/index.js",
      "default": "./dist/spin-wheel/index.js"
    },
    "./scratch-card": {
      "types": "./dist/scratch-card/index.d.ts",
      "import": "./dist/scratch-card/index.js",
      "default": "./dist/scratch-card/index.js"
    },
    "./slot-machine": {
      "types": "./dist/slot-machine/index.d.ts",
      "import": "./dist/slot-machine/index.js",
      "default": "./dist/slot-machine/index.js"
    },
    "./bingo": {
      "types": "./dist/bingo/index.d.ts",
      "import": "./dist/bingo/index.js",
      "default": "./dist/bingo/index.js"
    },
    "./dice": {
      "types": "./dist/dice/index.d.ts",
      "import": "./dist/dice/index.js",
      "default": "./dist/dice/index.js"
    },
    "./coin-flip": {
      "types": "./dist/coin-flip/index.d.ts",
      "import": "./dist/coin-flip/index.js",
      "default": "./dist/coin-flip/index.js"
    },
    "./lucky-box": {
      "types": "./dist/lucky-box/index.d.ts",
      "import": "./dist/lucky-box/index.js",
      "default": "./dist/lucky-box/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node ../../scripts/clean-output.mjs dist coverage",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
